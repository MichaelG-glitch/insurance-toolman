<div class="table-wrap"><table><thead><tr><th>賠款紀錄點數</th><th class="num">賠款紀錄係數</th></tr></thead><tbody><tr><td>−3</td><td class="num em">−0.6</td></tr><tr><td>−2</td><td class="num em">−0.4</td></tr><tr><td>−1</td><td class="num em">−0.2</td></tr><tr><td>0</td><td class="num em">0</td></tr><tr><td>＋1</td><td class="num em">＋0.2</td></tr><tr><td>＋2</td><td class="num em">＋0.4</td></tr><tr><td>＋3</td><td class="num em">＋0.6</td></tr><tr><td>3 點以上，每增加 1 點</td><td class="num em">再加 0.2</td></tr></tbody></table></div>
