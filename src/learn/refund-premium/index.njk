</g>
<g font-size="11" fill="var(--muted)">
<text x="112" y="318" text-anchor="middle">1</text><text x="178" y="318" text-anchor="middle">2</text><text x="244" y="318" text-anchor="middle">3</text><text x="310" y="318" text-anchor="middle">4</text><text x="376" y="318" text-anchor="middle">5</text><text x="442" y="318" text-anchor="middle">6</text><text x="508" y="318" text-anchor="middle">7</text><text x="574" y="318" text-anchor="middle">8</text><text x="640" y="318" text-anchor="middle">9</text><text x="706" y="318" text-anchor="middle">10</text><text x="772" y="318" text-anchor="middle">11</text><text x="838" y="318" text-anchor="middle">12</text>
</g>
