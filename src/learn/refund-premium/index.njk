<rect x="478" y="250" width="60" height="50" rx="4" fill="var(--warning-hi)" stroke="var(--warning)" stroke-width="1"/>
<text x="508" y="238" text-anchor="middle" font-size="12" font-weight="800" fill="var(--warning)">25%</text>
<rect x="544" y="265" width="60" height="35" rx="4" fill="var(--warning-hi)" stroke="var(--warning)" stroke-width="1"/>
