<rect x="610" y="280" width="60" height="20" rx="4" fill="var(--warning-hi)" stroke="var(--warning)" stroke-width="1"/>
<text x="640" y="268" text-anchor="middle" font-size="12" font-weight="800" fill="var(--warning)">15%</text>
<rect x="676" y="290" width="60" height="10" rx="4" fill="var(--warning-hi)" stroke="var(--warning)" stroke-width="1"/>
